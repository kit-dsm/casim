{
  "$defs": {
    "Accepts": {
      "enum": [
        "none",
        "insert",
        "rebuild"
      ],
      "title": "Accepts",
      "type": "string"
    },
    "CommitAllPolicy": {
      "additionalProperties": false,
      "properties": {},
      "title": "CommitAllPolicy",
      "type": "object"
    },
    "DecisionConfig": {
      "additionalProperties": false,
      "properties": {
        "problem_class": {
          "title": "Problem Class",
          "type": "string"
        },
        "state_information": {
          "$ref": "#/$defs/StateInformation"
        },
        "scope": {
          "$ref": "#/$defs/RevisionScope"
        },
        "commitment_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitAllPolicy"
            },
            {
              "$ref": "#/$defs/SchedulingCommitmentPolicy"
            },
            {
              "$ref": "#/$defs/WindowCommitmentPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commitment Policy"
        },
        "change_penalty": {
          "default": 0.0,
          "minimum": 0,
          "title": "Change Penalty",
          "type": "number"
        },
        "precedence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precedence"
        },
        "solver": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solver"
        },
        "triggers": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/PeriodicTrigger"
              }
            ]
          },
          "title": "Triggers",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "problem_class",
        "state_information",
        "scope"
      ],
      "title": "DecisionConfig",
      "type": "object"
    },
    "PeriodicTrigger": {
      "additionalProperties": false,
      "properties": {
        "every_s": {
          "exclusiveMinimum": 0,
          "title": "Every S",
          "type": "number"
        }
      },
      "required": [
        "every_s"
      ],
      "title": "PeriodicTrigger",
      "type": "object"
    },
    "ResourceStates": {
      "enum": [
        "off_shift",
        "idle",
        "reserved",
        "busy"
      ],
      "title": "ResourceStates",
      "type": "string"
    },
    "RevisionScope": {
      "additionalProperties": false,
      "properties": {
        "freeze_from": {
          "$ref": "#/$defs/TourStates"
        },
        "frozen_accepts": {
          "$ref": "#/$defs/Accepts"
        }
      },
      "required": [
        "freeze_from",
        "frozen_accepts"
      ],
      "title": "RevisionScope",
      "type": "object"
    },
    "SchedulingCommitmentPolicy": {
      "additionalProperties": false,
      "properties": {
        "n_jobs": {
          "default": 1,
          "title": "N Jobs",
          "type": "integer"
        }
      },
      "title": "SchedulingCommitmentPolicy",
      "type": "object"
    },
    "StateInformation": {
      "additionalProperties": false,
      "properties": {
        "orders": {
          "default": false,
          "title": "Orders",
          "type": "boolean"
        },
        "pick_lists": {
          "default": false,
          "title": "Pick Lists",
          "type": "boolean"
        },
        "tours": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TourStates"
          },
          "title": "Tours",
          "type": "array",
          "uniqueItems": true
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceStates"
          },
          "title": "Resources",
          "type": "array",
          "uniqueItems": true
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "StateInformation",
      "type": "object"
    },
    "TimeAttribute": {
      "enum": [
        "due_date",
        "start_time"
      ],
      "title": "TimeAttribute",
      "type": "string"
    },
    "TourStates": {
      "enum": [
        "planned",
        "scheduled",
        "pending",
        "started",
        "done",
        "cancelled"
      ],
      "title": "TourStates",
      "type": "string"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/TimeAttribute"
        },
        "horizon_s": {
          "title": "Horizon S",
          "type": "number"
        }
      },
      "required": [
        "by",
        "horizon_s"
      ],
      "title": "Window",
      "type": "object"
    },
    "WindowCommitmentPolicy": {
      "additionalProperties": false,
      "properties": {
        "within_s": {
          "title": "Within S",
          "type": "number"
        }
      },
      "required": [
        "within_s"
      ],
      "title": "WindowCommitmentPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/DecisionConfig"
      },
      "title": "Decisions",
      "type": "object"
    }
  },
  "required": [
    "decisions"
  ],
  "title": "DecisionDefinitions",
  "type": "object"
}
